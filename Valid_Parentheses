class Solution(object):
    def isValid(self, s):
        """
        :type s: str
        :rtype: bool
        """
        stack = []

        if len(s) % 2 != 0:
            return False

        i = 0
        while i < len(s):
            char = s[i]

            if char in "({[":
                stack.append(char)
            else:
                if not stack:
                    return False

                last_element = stack.pop()
                if (
                    (char == ")" and last_element != "(")
                    or (char == "}" and last_element != "{")
                    or (char == "]" and last_element != "[")
                ):
                    return False

            i += 1

        return len(stack) == 0
                     

         
